# Normalize line endings across all platforms
* text=auto

# Python
*.py text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf
*.wsgi text eol=lf

# Shell
*.sh text eol=lf
*.bash text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# JSON
*.json text eol=lf

# TOML
*.toml text eol=lf

# Markdown
*.md text eol=lf

# Documentation
*.rst text eol=lf
*.txt text eol=lf

# Config
*.cfg text eol=lf
*.conf text eol=lf
*.ini text eol=lf

# Binary files
*.db binary
*.sqlite binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary

# Executable
*.exe binary
*.dll binary
*.so binary
